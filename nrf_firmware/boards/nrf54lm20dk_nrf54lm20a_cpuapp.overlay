#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
	cpuapp_dma_region: cpuapp_dma_sram@2007ec00 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x2007ec00 DT_SIZE_K(4)>;
		#memory-region-cells = <0>;
		zephyr,memory-region = "DMA_RAM";
		status = "okay";
	};
};

&cpuapp_sram {
	/* Reserve 4 kB of DMA-safe RAM for TDM and TWIM EasyDMA buffers. */
	reg = <0x20000000 DT_SIZE_K(507)>;
	ranges = <0x0 0x20000000 0x7ec00>;
};

&pinctrl {
	tdm_default: tdm_default {
		group1 {
			psels = <NRF_PSEL(TDM_MCK, 1, 10)>,
				<NRF_PSEL(TDM_SCK_M, 1, 11)>,
				<NRF_PSEL(TDM_FSYNC_M, 1, 12)>,
				<NRF_PSEL(TDM_SDOUT, 1, 13)>,
				<NRF_PSEL(TDM_SDIN, 1, 14)>;
		};
	};

	i2c23_default: i2c23_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 3, 11)>,
				<NRF_PSEL(TWIM_SCL, 3, 12)>;
			bias-pull-up;
		};
	};
};
&tdm {
	status = "okay";
	pinctrl-0 = <&tdm_default>;
	pinctrl-names = "default";
	memory-regions = <&cpuapp_dma_region>;
	mck-frequency = <12288000>;
};

&i2c23 {
	status = "okay";
	pinctrl-0 = <&i2c23_default>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	memory-regions = <&cpuapp_dma_region>;
};

&gpio3 {
	status = "okay";
};
