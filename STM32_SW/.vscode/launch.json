{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug external memory - ST-Link",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "executable": "${workspaceFolder}/Boot/build/STM32_SW_Boot.elf", //"${command:STM32VSCodeExtension.bootFlashBootTarget}",
            "symbolFiles": [
                "${workspaceFolder}/Appli/build/STM32_SW_Appli.elf",
                "${workspaceFolder}/Boot/build/STM32_SW_Boot.elf",
                //"${command:STM32VSCodeExtension.bootFlashAppliTarget}",
                //"${command:STM32VSCodeExtension.bootFlashBootTarget}",
            ],
            "request": "launch",        
            "servertype": "stlink",
            "device": "STM32H7S3L8Hx",
            "interface": "swd",
            "serialNumber": "",        //Set ST-Link ID if you use multiple at the same time
            "runToEntryPoint": "dummy_entry_function",
            "svdFile": "${env:STM32CLT_PATH}/STMicroelectronics_CMSIS_SVD/STM32H7S.svd",
            "serverpath": "${env:STM32CLT_PATH}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "stm32cubeprogrammer":"${env:STM32CLT_PATH}/STM32CubeProgrammer/bin",
            "stlinkPath": "${env:STM32CLT_PATH}/STLink-gdb-server/bin/ST-LINK_gdbserver",   
            "armToolchainPath": "${env:STM32CLT_PATH}/GNU-tools-for-STM32/bin",
            "gdbPath":"${env:STM32CLT_PATH}/GNU-tools-for-STM32/bin/arm-none-eabi-gdb",
            "v1": false,
            "serverArgs": [
                "-m", "1",
                "-t", "-s", 
                "-el", "${env:STM32CLT_PATH}/STM32CubeProgrammer/bin/ExternalLoader/MX25UW25645G_NUCLEO-H7S3L8.stldr" // Default loader for current board
            ],
            "preLaunchTask": "Build + Flash in external Memory",
            "showDevDebugOutput": "raw",
        },
        {
            "name": "Debug external memory (clean rebuild) - ST-Link",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "executable": "${workspaceFolder}/Boot/build/STM32_SW_Boot.elf", //"${command:STM32VSCodeExtension.bootFlashBootTarget}",
            "symbolFiles": [
                "${workspaceFolder}/Appli/build/STM32_SW_Appli.elf",
                "${workspaceFolder}/Boot/build/STM32_SW_Boot.elf",
                //"${command:STM32VSCodeExtension.bootFlashAppliTarget}",
                //"${command:STM32VSCodeExtension.bootFlashBootTarget}",
            ],
            "request": "launch",        
            "servertype": "stlink",
            "device": "STM32H7S3L8Hx",
            "interface": "swd",
            "serialNumber": "",        //Set ST-Link ID if you use multiple at the same time
            "runToEntryPoint": "dummy_entry_function",
            "svdFile": "${env:STM32CLT_PATH}/STMicroelectronics_CMSIS_SVD/STM32H7S.svd",
            "serverpath": "${env:STM32CLT_PATH}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "stm32cubeprogrammer":"${env:STM32CLT_PATH}/STM32CubeProgrammer/bin",
            "stlinkPath": "${env:STM32CLT_PATH}/STLink-gdb-server/bin/ST-LINK_gdbserver",   
            "armToolchainPath": "${env:STM32CLT_PATH}/GNU-tools-for-STM32/bin",
            "gdbPath":"${env:STM32CLT_PATH}/GNU-tools-for-STM32/bin/arm-none-eabi-gdb",
            "v1": false,
            "serverArgs": [
                "-m", "1",
                "-t", "-s", 
                "-el", "${env:STM32CLT_PATH}/STM32CubeProgrammer/bin/ExternalLoader/MX25UW25645G_NUCLEO-H7S3L8.stldr" // Default loader for current board
            ],
            "preLaunchTask": "Clean Build + Flash in external Memory",
            "showDevDebugOutput": "raw",
        },
        {
            "name": "Attach external memory - ST-Link",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "executable": "${workspaceFolder}/Boot/build/STM32_SW_Boot.elf",//"${command:STM32VSCodeExtension.bootFlashBootTarget}",
            "symbolFiles": [
                "${workspaceFolder}/Appli/build/STM32_SW_Appli.elf", //"${command:STM32VSCodeExtension.bootFlashAppliTarget}",
                "${workspaceFolder}/Boot/build/STM32_SW_Boot.elf", //"${command:STM32VSCodeExtension.bootFlashBootTarget}",
            ],
            "request": "attach",
            "servertype": "stlink",
            "device": "STM32H7S3L8Hx", //MCU used
            "interface": "swd",
            "serialNumber": "",        //Set ST-Link ID if you use multiple at the same time
            "runToEntryPoint": "main",
            "svdFile": "${env:STM32CLT_PATH}/STMicroelectronics_CMSIS_SVD/STM32H7S.svd",
            "serverpath": "${env:STM32CLT_PATH}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "stm32cubeprogrammer":"${env:STM32CLT_PATH}/STM32CubeProgrammer/bin",
            "stlinkPath": "${env:STM32CLT_PATH}/STLink-gdb-server/bin/ST-LINK_gdbserver",   
            "armToolchainPath": "${env:STM32CLT_PATH}/GNU-tools-for-STM32/bin",
            "gdbPath":"${env:STM32CLT_PATH}/GNU-tools-for-STM32/bin/arm-none-eabi-gdb",            
            "v1": false,               //Change it depending on ST Link version
            "serverArgs": [
                "-m","1",
            ],
            /* If you use external loader, add additional arguments */
            //"serverArgs": ["--extload", "path/to/ext/loader.stldr"],
        }
    ]
}