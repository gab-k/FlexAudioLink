{
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "cmd.exe",
                "args": ["/d", "/c"]
            }
        }
    },
    "tasks": [
        {
            "type": "shell",
            "label": "CubeProg: Flash Application in external memory",
            "command": "STM32_Programmer_CLI",
            "args": [
                "--connect",
                "port=SWD",
                "reset=HWrst",
                //"-e",  // Optional erase all flash before flashing
                //"all",
                "-el",
                "${env:STM32CLT_PATH}/STM32CubeProgrammer/bin/ExternalLoader/MX25UW25645G_NUCLEO-H7S3L8.stldr", // Default loader for current board
                "-d",
                "${workspaceFolder}/Appli/build/STM32_SW_Appli.elf",
                "-HardRst"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "CubeProg: Flash Boot",
            "command": "STM32_Programmer_CLI",
            "args": [
                "--connect",
                "port=swd",
                "--download",
                "${workspaceFolder}/Boot/build/STM32_SW_Boot.elf",
                "-hardRst",
                "-rst",
                "--start"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CubeProg: Flash",
            "dependsOrder": "sequence",
            "dependsOn": [
                "CubeProg: Flash Application in external memory",
                "CubeProg: Flash Boot",
            ]
        },
        {
            "label": "Build + Flash in external Memory",
            "dependsOrder": "sequence",
            "dependsOn": [
                "CMake: build",
                "CubeProg: Flash",
            ]
        },
        {
            "label": "Clean Build + Flash in external Memory",
            "dependsOrder": "sequence",
            "dependsOn": [
                "CMake: clean rebuild",
                "CubeProg: Flash",
            ]
        },
        {
            "type": "cmake",
            "label": "CMake: clean rebuild",
            "command": "cleanRebuild",
            "targets": [
                "all"
            ],
            "preset": "${command:cmake.activeBuildPresetName}",
            "group": "build",
            "problemMatcher": [],
            "detail": "CMake template clean rebuild task"
        },
        {
            "type": "cmake",
            "label": "CMake: build",
            "command": "build",
            "targets": [
                "all"
            ],
            "preset": "${command:cmake.activeBuildPresetName}",
            "group": "build",
            "problemMatcher": [],
            "detail": "CMake template build task"
        },
        {
            "type": "shell",
            "label": "CubeProg: List all available communication interfaces",
            "command": "STM32_Programmer_CLI",
            "args": ["--list"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
